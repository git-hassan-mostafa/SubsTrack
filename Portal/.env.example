# The public customer-portal edge function. Deployed verify_jwt = false.
VITE_PORTAL_FUNCTION_URL=https://vyvhmvoiewhtzvrmyknp.supabase.co/functions/v1/customer-portal

# Supabase rejects a function call with no API key even at verify_jwt = false.
# This is the same public anon key the staff app ships; on its own it reaches
# only app_options, and every table stays behind RLS.
VITE_SUPABASE_ANON_KEY=<the project anon key>
