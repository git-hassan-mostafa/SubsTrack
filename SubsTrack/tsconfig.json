{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"],
      "i18next": ["./node_modules/i18next"],
      "@shared/*": ["../Shared/src/*"],
      "@edge/*": ["./supabase/functions/_shared/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["supabase/functions/**"]
}
