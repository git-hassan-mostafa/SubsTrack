{
  "name": "sijil",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "deploy-create-user-edge-function": "supabase functions deploy create-user",
    "deploy-delete-user-edge-function": "supabase functions deploy delete-user",
    "deploy-update-user-password-edge-function": "supabase functions deploy update-user-password",
    "deploy-create-tenant-edge-function": "supabase functions deploy create-tenant --no-verify-jwt",
    "deploy-whatsapp-functions": "supabase functions deploy whatsapp-admin && supabase functions deploy whatsapp-send && supabase functions deploy whatsapp-onboard --no-verify-jwt && supabase functions deploy whatsapp-worker --no-verify-jwt && supabase functions deploy whatsapp-webhook --no-verify-jwt",
    "deploy-all-functions": "npm run deploy-create-user-edge-function && npm run deploy-delete-user-edge-function && npm run deploy-update-user-password-edge-function && npm run deploy-create-tenant-edge-function && supabase functions deploy customer-portal --no-verify-jwt && npm run deploy-whatsapp-functions",
    "eas-configure": "eas build:configure",
    "build-dev": "eas build --platform android --profile development",
    "build-preview": "eas build --platform android --profile preview",
    "build-prod": "eas build --platform android --profile production",
    "ota-preview": "eas update --channel preview --environment preview --platform android",
    "ota-prod": "eas update --channel production --environment production --platform android",
    "ota-fingerprint": "node ./scripts/print-fingerprint.js",
    "build-web": "npx expo export -p web",
    "serve-web": "npm run build-web && node -e \"require('fs').copyFileSync('serve.json', 'dist/serve.json')\" && npx serve dist"
  },
  "dependencies": {
    "@expo/ui": "~57.0.25",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.105.1",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.30",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "i18next": "^26.0.8",
    "immer": "^11.1.8",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.6",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler"
      ]
    }
  },
  "private": true
}
