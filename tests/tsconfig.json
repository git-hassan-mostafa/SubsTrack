{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["jest", "node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["../SubsTrack/*"] }
  },
  "include": [
    "suites/**/*.ts",
    "helpers/**/*.ts",
    "stubs/**/*.ts",
    "../SubsTrack/nativewind-env.d.ts",
    "../SubsTrack/expo-env.d.ts",
    "../SubsTrack/.expo/types/**/*.ts"
  ]
}
