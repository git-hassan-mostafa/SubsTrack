# Copy to .env for local work; on Vercel set the same names in Environment Variables.
# All are public: Vite bakes them into the pages. The build stops if a required one is missing.

# Digits only with the country code: no +, spaces or dashes (e.g. 96170123456).
# Same number as the app option SupportWhatsAppNumber.
VITE_SUPPORT_WHATSAPP_NUMBER=

# Shown on the privacy, terms and delete-account pages.
VITE_SUPPORT_EMAIL=

# Where the Website is published, no trailing slash. Same as the app option WebsiteUrl.
# Link previews on WhatsApp / Facebook need it to show the share image.
VITE_SITE_URL=

# The Supabase project the apps use (same as EXPO_PUBLIC_SUPABASE_URL), no trailing slash.
# The package cards read their prices from it: SuperAdmin → Options → Package300Usd,
# Package500Usd, Package1000Usd. A blank price shows "Ask us for the price".
VITE_SUPABASE_URL=

# The public anon key (same as EXPO_PUBLIC_SUPABASE_ANON_KEY). It can only read app_options.
VITE_SUPABASE_ANON_KEY=
